    {
      "id": "c01",
      "area": "comunicacion",
      "texto": "No se voltea cuando lo o la llaman por su nombre.",
      "signo_referencia": "Respuesta al nombre",
      "valores": {
        "casi_siempre": 2,
        "a_veces": 1,
        "casi_nunca": 0
      },
      "edad_min_meses": 9
    },
    {
      "id": "c02",
      "area": "comunicacion",
      "texto": "No señala con el dedo para pedir algo o para mostrar lo que le interesa.",
      "signo_referencia": "Señalar protodeclarativo",
      "valores": {
        "casi_siempre": 2,
        "a_veces": 1,
        "casi_nunca": 0
      },
      "edad_min_meses": 12
    },
    {
      "id": "c03",
      "area": "comunicacion",
      "texto": "Usa pocos gestos, como decir adiós con la mano o mover la cabeza para decir sí o no.",
