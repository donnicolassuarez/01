        "casi_siempre": 2,
        "a_veces": 1,
        "casi_nunca": 0
      },
      "edad_min_meses": 18
    },
    {
      "id": "r04",
      "area": "conductas",
      "texto": "Reacciona de forma muy fuerte a ciertos ruidos, texturas o sabores.",
