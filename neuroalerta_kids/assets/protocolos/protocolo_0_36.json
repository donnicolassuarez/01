      "valores": {
        "casi_siempre": 2,
        "a_veces": 1,
        "casi_nunca": 0
      },
      "edad_min_meses": 9
    },
    {
      "id": "s04",
      "area": "interaccion",
      "texto": "No busca compartir lo que le gusta: no le trae ni le enseña juguetes u objetos.",
      "signo_referencia": "Atención conjunta",
      "valores": {
        "casi_siempre": 2,
        "a_veces": 1,
        "casi_nunca": 0
      },
      "edad_min_meses": 12
    },
    {
      "id": "s05",
      "area": "interaccion",
      "texto": "Muestra poco interés por otros niños.",
      "signo_referencia": "Interés social",
      "valores": {
        "casi_siempre": 2,
        "a_veces": 1,
        "casi_nunca": 0
      },
      "edad_min_meses": 18
    },
    {
      "id": "r01",
      "area": "conductas",
      "texto": "Se queda mirando cosas que giran, como ruedas o ventiladores, o alinea juguetes una y otra vez.",
