      "valores": {
        "casi_siempre": 2,
        "a_veces": 1,
        "casi_nunca": 0
      }
    },
    {
      "id": "s03",
      "area": "interaccion",
      "texto": "Le cuesta darse cuenta de cómo se sienten los demás o consolar a alguien.",
      "signo_referencia": "Empatía y reciprocidad emocional",
      "valores": {
        "casi_siempre": 2,
        "a_veces": 1,
        "casi_nunca": 0
      }
    },
    {
      "id": "s04",
      "area": "interaccion",
      "texto": "Casi no mira a la cara cuando se le habla.",
