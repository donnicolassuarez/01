      "valores": {
        "casi_siempre": 2,
        "a_veces": 1,
        "casi_nunca": 0
      }
    },
    {
      "id": "r01",
      "area": "conductas",
      "texto": "Se altera mucho si cambia la rutina o el camino de siempre.",
      "signo_referencia": "Rigidez ante cambios",
      "valores": {
        "casi_siempre": 2,
        "a_veces": 1,
        "casi_nunca": 0
      }
    },
    {
      "id": "r02",
      "area": "conductas",
      "texto": "Juega siempre igual, o alinea y ordena sus juguetes en lugar de jugar con ellos.",
