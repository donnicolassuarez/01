      "valores": {
        "casi_siempre": 2,
        "a_veces": 1,
        "casi_nunca": 0
      }
    },
    {
      "id": "a01",
      "area": "atencion",
      "texto": "Se distrae con facilidad cuando hace algo que le gusta poco.",
      "signo_referencia": "Distractibilidad",
      "valores": {
        "casi_siempre": 2,
        "a_veces": 1,
        "casi_nunca": 0
      }
    },
    {
      "id": "a02",
      "area": "atencion",
      "texto": "Le cuesta terminar un juego o una tarea sencilla.",
