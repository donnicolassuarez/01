      "valores": {
        "casi_siempre": 2,
        "a_veces": 1,
        "casi_nunca": 0
      }
    },
    {
      "id": "s01",
      "area": "interaccion",
      "texto": "Prefiere jugar solo o sola y no se acerca a otros niños.",
