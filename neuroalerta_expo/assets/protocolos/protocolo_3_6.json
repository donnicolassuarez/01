        "casi_siempre": 2,
        "a_veces": 1,
        "casi_nunca": 0
      }
    },
    {
      "id": "c04",
      "area": "comunicacion",
      "texto": "Le cuesta sostener una conversación de ida y vuelta, aunque sea corta.",
