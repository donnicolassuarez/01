      "valores": {
        "casi_siempre": 2,
        "a_veces": 1,
        "casi_nunca": 0
      }
    },
    {
      "id": "h02",
      "area": "hiperactividad",
      "texto": "Corre o trepa en lugares donde no debe, más que otros niños de su edad.",
