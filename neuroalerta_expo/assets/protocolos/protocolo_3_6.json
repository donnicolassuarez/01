      "valores": {
        "casi_siempre": 2,
        "a_veces": 1,
        "casi_nunca": 0
      }
    },
    {
      "id": "s02",
      "area": "interaccion",
      "texto": "Casi no juega a imaginar, como cuidar muñecos o hacer de cuenta que cocina.",
