        "casi_siempre": 2,
        "a_veces": 1,
        "casi_nunca": 0
      }
    },
    {
      "id": "c03",
      "area": "comunicacion",
      "texto": "Repite frases enteras de videos o de lo que escucha, en lugar de responder.",
