  "items": [
    {
      "id": "c01",
      "area": "comunicacion",
      "texto": "No se voltea cuando lo o la llaman por su nombre.",
      "signo_referencia": "Respuesta al nombre",
      "valores": {
        "casi_siempre": 2,
        "a_veces": 1,
        "casi_nunca": 0
      },
      "edad_min_meses": 9,
      "afin_mchat": "Respuesta al nombre"
    },
    {
      "id": "c02",
      "area": "comunicacion",
      "texto": "No señala con el dedo para pedir algo que quiere, por ejemplo un juguete que no alcanza.",
      "signo_referencia": "Señalar para pedir",
      "valores": {
        "casi_siempre": 2,
        "a_veces": 1,
        "casi_nunca": 0
      },
      "edad_min_meses": 12,
      "afin_mchat": "Señalar para pedir"
    },
    {
      "id": "c06",
      "area": "comunicacion",
      "texto": "No señala con el dedo para enseñarle algo que le interesa.",
      "signo_referencia": "Señalar para compartir interés",
      "valores": {
        "casi_siempre": 2,
        "a_veces": 1,
        "casi_nunca": 0
      },
      "edad_min_meses": 12,
      "afin_mchat": "Señalar para compartir interés"
    },
    {
      "id": "c07",
      "area": "comunicacion",
      "texto": "No mira hacia donde usted señala cuando le dice «mira» y apunta a algo lejos.",
      "signo_referencia": "Seguir el señalamiento",
      "valores": {
        "casi_siempre": 2,
        "a_veces": 1,
        "casi_nunca": 0
      },
      "edad_min_meses": 12,
      "afin_mchat": "Seguir el señalamiento del adulto"
    },
    {
      "id": "c03",
      "area": "comunicacion",
      "texto": "Usa pocos gestos, como decir adiós con la mano o mover la cabeza para decir sí o no.",
      "signo_referencia": "Gestos comunicativos",
      "valores": {
        "casi_siempre": 2,
        "a_veces": 1,
        "casi_nunca": 0
      },
      "edad_min_meses": 12
    },
    {
      "id": "c08",
      "area": "comunicacion",
      "texto": "Parece no entender cuando usted le pide algo sencillo sin hacer gestos, como «dame» o «ven».",
      "signo_referencia": "Comprensión de indicaciones simples",
      "valores": {
        "casi_siempre": 2,
        "a_veces": 1,
        "casi_nunca": 0
      },
      "edad_min_meses": 16,
      "afin_mchat": "Comprensión de indicaciones simples"
    },
    {
      "id": "c09",
      "area": "comunicacion",
      "texto": "Ha dudado de que oiga bien, porque casi no reacciona a los sonidos.",
      "signo_referencia": "Duda sobre la audición",
      "valores": {
        "casi_siempre": 2,
        "a_veces": 1,
        "casi_nunca": 0
      },
      "edad_min_meses": 6,
      "afin_mchat": "Duda sobre la audición"
    },
    {
      "id": "c04",
      "area": "comunicacion",
      "texto": "Dice muy pocas palabras para su edad.",
      "signo_referencia": "Lenguaje expresivo",
      "valores": {
        "casi_siempre": 2,
        "a_veces": 1,
        "casi_nunca": 0
      },
      "edad_min_meses": 16
    },
    {
      "id": "c05",
      "area": "comunicacion",
      "texto": "Repite palabras o frases que escucha, sin usarlas para pedir o contar algo.",
      "signo_referencia": "Ecolalia",
      "valores": {
        "casi_siempre": 2,
        "a_veces": 1,
        "casi_nunca": 0
      },
      "edad_min_meses": 18
    },
    {
      "id": "s01",
      "area": "interaccion",
      "texto": "Casi no sonríe ni responde con gestos cuando usted le sonríe o le habla.",
      "signo_referencia": "Sonrisa social",
      "valores": {
        "casi_siempre": 2,
        "a_veces": 1,
        "casi_nunca": 0
      },
      "edad_min_meses": 4,
      "afin_mchat": "Sonrisa en respuesta"
    },
    {
      "id": "s02",
      "area": "interaccion",
      "texto": "Rara vez lo mira a los ojos cuando le hablan o juegan.",
      "signo_referencia": "Contacto visual",
      "valores": {
        "casi_siempre": 2,
        "a_veces": 1,
        "casi_nunca": 0
      },
      "edad_min_meses": 6,
      "afin_mchat": "Contacto visual"
    },
    {
      "id": "s03",
      "area": "interaccion",
      "texto": "No imita lo que usted hace, como aplaudir, hacer caras o jugar a esconderse y aparecer.",
      "signo_referencia": "Imitación",
      "valores": {
        "casi_siempre": 2,
        "a_veces": 1,
        "casi_nunca": 0
      },
      "edad_min_meses": 9,
      "afin_mchat": "Imitación"
    },
    {
      "id": "s04",
      "area": "interaccion",
      "texto": "No le trae ni le levanta objetos para enseñárselos.",
      "signo_referencia": "Mostrar objetos",
      "valores": {
        "casi_siempre": 2,
        "a_veces": 1,
        "casi_nunca": 0
      },
      "edad_min_meses": 12,
      "afin_mchat": "Mostrar objetos al adulto"
    },
    {
      "id": "s06",
      "area": "interaccion",
      "texto": "No busca que usted lo mire ni que participe en lo que está haciendo.",
      "signo_referencia": "Llamar la atención del adulto",
      "valores": {
        "casi_siempre": 2,
        "a_veces": 1,
        "casi_nunca": 0
      },
      "edad_min_meses": 12,
      "afin_mchat": "Buscar que el adulto mire"
    },
    {
      "id": "s07",
      "area": "interaccion",
      "texto": "Cuando pasa algo nuevo o extraño, no la o lo mira a usted para ver cómo reacciona.",
      "signo_referencia": "Referencia social",
      "valores": {
        "casi_siempre": 2,
        "a_veces": 1,
        "casi_nunca": 0
      },
      "edad_min_meses": 12,
      "afin_mchat": "Referencia social"
    },
    {
      "id": "s05",
      "area": "interaccion",
      "texto": "Muestra poco interés por otros niños.",
      "signo_referencia": "Interés social",
      "valores": {
        "casi_siempre": 2,
        "a_veces": 1,
        "casi_nunca": 0
      },
      "edad_min_meses": 18,
      "afin_mchat": "Interés en otros niños"
    },
    {
      "id": "s08",
      "area": "interaccion",
      "texto": "Casi no hace juego de imaginar, como dar de comer a un muñeco o hablar por un teléfono de juguete.",
      "signo_referencia": "Juego simbólico",
      "valores": {
        "casi_siempre": 2,
        "a_veces": 1,
        "casi_nunca": 0
      },
      "edad_min_meses": 14,
      "afin_mchat": "Juego simbólico"
    },
    {
      "id": "r01",
      "area": "conductas",
      "texto": "Se queda mirando cosas que giran, como ruedas o ventiladores, o alinea juguetes una y otra vez.",
      "signo_referencia": "Intereses sensoriales o repetitivos",
      "valores": {
        "casi_siempre": 2,
        "a_veces": 1,
        "casi_nunca": 0
      },
      "edad_min_meses": 12
    },
    {
      "id": "r02",
      "area": "conductas",
      "texto": "Repite movimientos como aletear con las manos, balancearse o caminar en puntas de pie.",
      "signo_referencia": "Estereotipias motoras",
      "valores": {
        "casi_siempre": 2,
        "a_veces": 1,
        "casi_nunca": 0
      },
      "edad_min_meses": 12
    },
    {
      "id": "r05",
      "area": "conductas",
      "texto": "Hace movimientos raros con los dedos cerca de los ojos.",
      "signo_referencia": "Movimientos inusuales de los dedos",
      "valores": {
        "casi_siempre": 2,
        "a_veces": 1,
        "casi_nunca": 0
      },
      "edad_min_meses": 12,
      "afin_mchat": "Movimientos inusuales de los dedos"
    },
    {
      "id": "r03",
      "area": "conductas",
      "texto": "Se molesta mucho cuando cambia su rutina o algo de lugar.",
      "signo_referencia": "Rigidez ante cambios",
      "valores": {
        "casi_siempre": 2,
        "a_veces": 1,
        "casi_nunca": 0
      },
      "edad_min_meses": 18
    },
    {
      "id": "r04",
      "area": "conductas",
      "texto": "Se molesta mucho con ruidos de todos los días, como la licuadora o la aspiradora.",
      "signo_referencia": "Sensibilidad a sonidos cotidianos",
      "valores": {
        "casi_siempre": 2,
        "a_veces": 1,
        "casi_nunca": 0
      },
      "edad_min_meses": 12,
      "afin_mchat": "Sensibilidad a sonidos cotidianos"
    }
  ],
